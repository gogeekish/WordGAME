{
  "name": "word-arena-tv-offline",
  "version": "2.0.0",
  "description": "Offline LAN Word Arena TV scoreboard and timer",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wordarenatv.app",
    "productName": "Word Arena TV",
    "files": [
      "server.js",
      "admin.html",
      "public.html",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
